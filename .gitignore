# ================================
# LearnPath - Root .gitignore
# ================================

# -------------------------------
# Node.js Dependencies
# -------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -------------------------------
# Environment Variables
# -------------------------------
.env
.env.*
!.env.example

# -------------------------------
# Build and Production Files
# -------------------------------
dist/
build/
out/
coverage/
.next/

# -------------------------------
# Logs
# -------------------------------
logs/
*.log

# -------------------------------
# OS Generated Files
# -------------------------------
.DS_Store
Thumbs.db
Desktop.ini

# -------------------------------
# IDE and Editor Files
# -------------------------------
.vscode/
.idea/
*.swp
*.swo
*.tmp

# -------------------------------
# Python Files (ML Service)
# -------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc

# Python Virtual Environments
venv/
.venv/
env/
ENV/

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/

# Python Packaging
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# -------------------------------
# Machine Learning Artifacts
# -------------------------------
*.pkl
*.joblib
*.h5
*.onnx
*.pt

# -------------------------------
# ML Service Generated Files
# -------------------------------
ml-service/trained_models/*
!ml-service/trained_models/.gitkeep

# -------------------------------
# Temporary Files
# -------------------------------
*.temp
*.bak
*.cache/

# -------------------------------
# Testing and Coverage Reports
# -------------------------------
coverage.xml
htmlcov/
.pytest_cache/

# -------------------------------
# Database Files (Local)
# -------------------------------
*.db
*.sqlite3

# -------------------------------
# Miscellaneous
# -------------------------------
*.tgz
*.zip
*.tar
*.rar