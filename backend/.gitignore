# ==========================================
# LearnPath - Backend .gitignore
# ==========================================

# Node.js Dependencies
node_modules/

# Environment Variables
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime Files
pids/
*.pid
*.seed
*.pid.lock

# Coverage Directory
coverage/

# Build Outputs
dist/
build/

# Temporary Files
tmp/
temp/
*.tmp

# OS Files
.DS_Store
Thumbs.db
Desktop.ini

# IDE and Editor Files
.vscode/
.idea/
*.swp
*.swo
*.swn

# Nodemon Cache
.nodemon/

# Miscellaneous
*.bak
*.cache

# Optional: Ignore local uploads or generated files
uploads/
public/uploads/

# Optional: Ignore local database files
*.db
*.sqlite
*.sqlite3