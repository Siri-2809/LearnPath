# ===============================
# ML Service Configuration
# ===============================

# FastAPI Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True
ENVIRONMENT=development

# API Configuration
API_TITLE=LearnPath ML Service
API_VERSION=1.0.0
API_DESCRIPTION=Machine Learning Microservice for Skill Gap Analysis and Recommendations

# ===============================
# Model Paths
# ===============================
SKILL_GAP_MODEL_PATH=trained_models/skill_gap_model.pkl
RECOMMENDATION_MODEL_PATH=trained_models/recommendation_model.pkl

# ===============================
# Dataset Paths
# ===============================
TRAINING_DATA_PATH=data/training_data.csv

# ===============================
# CORS Settings
# ===============================
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===============================
# Integration with Node.js Backend
# ===============================
BACKEND_API_URL=http://localhost:5000/api

# ===============================
# Logging Configuration
# ===============================
LOG_LEVEL=INFO

# ===============================
# Security & Reproducibility
# ===============================
SECRET_KEY=learnpath_ml_service_secret
MODEL_RANDOM_STATE=42