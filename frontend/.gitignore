# ============================================
# LearnPath Frontend - .gitignore
# ============================================

# Dependencies
/node_modules
/.pnp
.pnp.js

# Production Build
/build
/dist

# Environment Variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing
/coverage

# Cache Files
.cache
.eslintcache

# OS Files
.DS_Store
Thumbs.db

# IDE and Editor Settings
.vscode/
.idea/
*.swp
*.swo
*.log

# Temporary Files
*.tmp
*.temp

# Parcel & Bundler Files
.parcel-cache/

# Vite Files (if migrated in future)
.vite/

# Optional TypeScript Files
*.tsbuildinfo

# Storybook Build
/storybook-static

# WebStorm / IntelliJ
out/

# Miscellaneous
*.bak
*.orig

# Local Netlify Folder
.netlify

# Local Deployment Settings
.vercel

# Ignore package lock files only if necessary
# (Recommended to keep them for consistency)
# package-lock.json
# yarn.lock